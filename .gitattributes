# Jedan format prelaska u novi red za ceo repo, na svakoj masini.
# Bez ovoga fixture-i su CRLF na Windowsu i LF na Linuxu, pa parser
# dobija razlicit ulaz a niko to ne primeti (pravilo 21).
* text=auto eol=lf

*.py    text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.svg   text eol=lf

gradlew     text eol=lf
gradlew.bat text eol=crlf

*.jar  binary
*.png  binary
*.ico  binary
*.jpg  binary
*.webp binary
