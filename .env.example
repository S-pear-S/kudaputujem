# --- Baza -------------------------------------------------------------------
POSTGRES_DB=kudaputujem
POSTGRES_USER=kudaputujem
POSTGRES_PASSWORD=promeni_me
DATABASE_URL=postgresql://kudaputujem:promeni_me@localhost:5432/kudaputujem

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- API --------------------------------------------------------------------
API_BASE_URL=http://localhost:8080
# Ključ kojim se skreperi autentikuju ka /internal/ingest. Odvojen od admin ključa.
INGEST_API_KEY=promeni_me
ADMIN_API_KEY=promeni_me_takodje

# --- Skreperi ---------------------------------------------------------------
SCRAPER_USER_AGENT=KudaPutujemBot/0.1 (+https://kudaputujem.rs/bot; kontakt@kudaputujem.rs)
SCRAPER_DEFAULT_DELAY_MS=2000
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_CACHE_DIR=.cache

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
