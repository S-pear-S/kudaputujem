[importlinter]
root_packages =
    travelcore
    travelscrape
    travelapi
include_external_packages = True

[importlinter:contract:travelcore-je-cist]
name = travelcore ne sme da zavisi od scraping biblioteka
type = forbidden
source_modules = travelcore
forbidden_modules =
    httpx
    selectolax
    typer
    structlog
    tenacity
    playwright
    rich

[importlinter:contract:smer-zavisnosti]
name = travelcore ne sme da zna za travelscrape
type = forbidden
source_modules = travelcore
forbidden_modules = travelscrape

[importlinter:contract:api-ne-zna-za-skreper]
name = travelapi ne sme da uvozi travelscrape
type = forbidden
source_modules = travelapi
forbidden_modules = travelscrape
